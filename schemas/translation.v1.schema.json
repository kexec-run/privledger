{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privledger Translated Transcript v1",
  "type": "object",
  "required": ["result", "translation", "transcription"],
  "additionalProperties": false,
  "properties": {
    "result": {
      "type": "object",
      "required": ["language", "source_language"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "source_language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "translation": {
      "type": "object",
      "required": ["source_file", "source_sha256", "target_language"],
      "additionalProperties": false,
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transcription": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["timestamps", "offsets", "text", "source_text"],
      "additionalProperties": false,
      "properties": {
        "timestamps": {
          "$ref": "#/$defs/timestamps"
        },
        "offsets": {
          "$ref": "#/$defs/offsets"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_text": {
          "type": "string"
        }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "to": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9],[0-9]{3}$"
    },
    "offsets": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
