{
  "type": "object",
  "required": [
    "id",
    "timestamp_utc",
    "schema_version",
    "pipeline_version",
    "metadata_quality",
    "media_file"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp_local": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "schema_version": { "type": "integer" },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "metadata_quality": {
      "type": "string",
      "enum": ["basic", "full", "corrected", "bad"]
    },
    "media_file": {
      "type": "string",
      "minLength": 1
    },
    "video_device": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "transcript_file": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "mood": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "energy": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "stress": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "sleepiness": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "sleep_hours": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "caffeine_mg": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "body_weight": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "focus_domain": { "type": ["string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "maxItems": 5
    },
    "location": { "type": ["string", "null"] }
  }
}
