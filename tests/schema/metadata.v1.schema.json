{
  "type": "object",
  "required": [
    "id",
    "timestamp_utc",
    "schema_version",
    "pipeline_version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },

    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },

    "schema_version": { "type": "integer" },
    "pipeline_version": { "type": "string" },

    "metadata_quality": {
      "type": "string",
      "enum": ["basic", "full", "corrected"]
    },

    "mood": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "energy": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "stress": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "sleepiness": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },

    "sleep_hours": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "caffeine_mg": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "body_weight": {
      "type": ["number", "null"],
      "minimum": 0
    },

    "focus_domain": { "type": ["string", "null"] },

    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },

    "location": { "type": ["string", "null"] }
  }
}
